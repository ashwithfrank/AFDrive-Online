# Copy this file to .env and edit the values below.
# .env is excluded from Git — never commit real secrets.

# --- Account -----------------------------------------------------------
AFDRIVE_USERNAME=admin
AFDRIVE_PASSWORD=changeme123

# --- Storage -------------------------------------------------------------
AFDRIVE_STORAGE_PATH=./storage/user_files

# --- Upload limits ---------------------------------------------------------
AFDRIVE_MAX_UPLOAD_SIZE=2147483648

# --- Server ----------------------------------------------------------------
AFDRIVE_HOST=0.0.0.0
AFDRIVE_PORT=5000
AFDRIVE_DEBUG=false

# --- Security --------------------------------------------------------------
# AFDRIVE_SECRET_KEY=
AFDRIVE_FORCE_HTTPS=false
AFDRIVE_SESSION_DAYS=7

# --- Online mode (all optional — leave AFDRIVE_ONLINE_ENABLED unset or
#     false to run exactly like the original LAN-only AFDrive) -------------

# Master switch for connecting to AFDrive Online.
AFDRIVE_ONLINE_ENABLED=false

# Base URL of the AFDrive Online relay you're registering with.
AFDRIVE_RELAY_URL=https://relay.afdrive.example

# Shown in the public directory and your owner dashboard.
AFDRIVE_SERVER_NAME=My AFDrive

# Whether this storage is listed on the public discovery page. Leave
# false to keep it reachable only via a direct share link/permission.
AFDRIVE_PUBLIC=false

# One-time pairing code from the Online dashboard. Only needed for the
# very first run — after that, instance/device_identity.json is used.
# AFDRIVE_PAIRING_CODE=
