# Copy to .env — never commit real values.
# This process is the relay ONLY. It serves no HTML pages. The frontend
# is the separate static site in /site, deployed on GitHub Pages, which
# talks to Supabase directly and to this relay only for the file-manager
# proxy (/s/:serverId/*) and the two live-socket admin actions.

# --- Server ------------------------------------------------------------
PORT=8080
NODE_ENV=production

# Comma-separated list of frontend origins allowed to call this relay,
# e.g. the GitHub Pages URL. No trailing slash. Leave empty only for
# local development (it disables the origin check).
ALLOWED_ORIGINS=https://your-username.github.io

# --- Supabase ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key: SERVER-SIDE ONLY. Never sent to the browser, never
# referenced anywhere under /site. Used by this process to read/write
# servers, access_grants, and audit_log across all owners.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Rate limiting ---------------------------------------------------------
REGISTER_RATE_LIMIT_PER_15MIN=10
