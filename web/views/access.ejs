<%- include('partials/head', { title: 'Access · ' + server.display_name }) %>

<p><a href="/dashboard">&larr; Back to dashboard</a></p>
<h1>Access — <%= server.display_name %></h1>

<% if (server.is_public) { %>
  <p class="muted">
    This storage is currently <strong>public</strong> — anyone can reach its
    login page. Access grants below only matter once you make it private.
  </p>
<% } %>

<% if (error) { %><p class="error-msg"><%= error %></p><% } %>

<form method="post" action="/dashboard/servers/<%= server.id %>/access" class="inline-form-block">
  <label>Email<input type="email" name="email" required /></label>
  <label>
    Role
    <select name="role">
      <option value="read">Read-only</option>
      <option value="read_write">Read/write</option>
    </select>
  </label>
  <button class="btn btn-primary" type="submit">Grant access</button>
</form>

<% if (grants.length === 0) { %>
  <p class="empty-state">No one else has been granted access yet.</p>
<% } else { %>
  <ul class="grant-list">
    <% grants.forEach(function(g) { %>
      <li>
        <span><%= g.invited_email %></span>
        <span class="tag"><%= g.role === 'read_write' ? 'Read/write' : 'Read-only' %></span>
        <form method="post" action="/dashboard/servers/<%= server.id %>/access/<%= g.id %>/revoke" class="inline-form">
          <button class="btn btn-small btn-danger" type="submit">Revoke</button>
        </form>
      </li>
    <% }); %>
  </ul>
<% } %>

<%- include('partials/foot') %>
