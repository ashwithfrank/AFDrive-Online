# Copy to .env — never commit real values.

# --- Server ------------------------------------------------------------
PORT=8080
NODE_ENV=production
# Public base URL this relay is reachable at (used to build absolute
# links, and shown to Agents as RELAY_URL).
PUBLIC_BASE_URL=https://afdrive.example

# --- Supabase ------------------------------------------------------------
# Anon key: safe for the browser (dashboard client-side auth widget).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key: SERVER-SIDE ONLY. Never sent to the browser, never
# imported by anything under web/public/. Used by the relay process to
# read/write servers, access_grants, and audit_log across all owners.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Session/cookies -------------------------------------------------------
# Random 32+ byte value, distinct from any Agent's secret key.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Rate limiting ---------------------------------------------------------
LOGIN_RATE_LIMIT_PER_15MIN=20
REGISTER_RATE_LIMIT_PER_15MIN=10
